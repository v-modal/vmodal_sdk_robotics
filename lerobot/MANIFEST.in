include LICENSE README.md pyproject.toml setup.cfg test.sh ros2_test.sh install.sh cli.sh docs.py utils.py public_release_filter.txt
recursive-include docs *.md *.json
include docs_sdk/README.md
recursive-include examples *.py *.sh *.service *.env
recursive-include tests *.py *.Dockerfile
recursive-include src/utils *.py
include src/__init__.py
prune ztmp
prune ztmp_sandbox
prune build
prune dist
global-exclude __pycache__ *.py[cod]
