include LICENSE README.md pyproject.toml test.sh ros2_test.sh install.sh cli.sh docs.py utils.py public_release_filter.txt
recursive-include docs *.md *.json
include docs_sdk/README.md
recursive-include examples *.py *.json
recursive-include tests *.py *.json *.jsonl *.wav *.mp4 *.parquet
prune ztmp
prune ztmp_sandbox
prune build
prune dist
global-exclude __pycache__ *.py[cod]
